# Archivo de variables de entorno para Producción en AWS (docker-compose.prod.yml)
# Copia este archivo a .env en el servidor: cp .env.example .env

# Base de Datos PostgreSQL
POSTGRES_DB=uml_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Google Gemini API Key (Copiar tu API key de Google AI Studio)
GEMINI_API_KEY=tu_gemini_api_key_aqui
